@@ -1637,24 +1631,39 @@ def goto(page: str) -> None:
     ss_.page = page
 
 
+AV_USER, AV_BOT = ":material/person:", ":material/auto_awesome:"
+
+
+def _fb_changed(uid: str) -> None:
+    """st.feedback('thumbs') returns 1 (up), 0 (down) or None (cleared)."""
+    c = next((t for t in ss_.chat if t["uid"] == uid), None)
+    if c is None:
+        return
+    c["rating"] = {1: 1, 0: -1}.get(ss_.get(f"fb_{uid}"))
+    if c["rating"] is not None:
+        audit("feedback", rating=c["rating"], question=c["q"])
+
+
 def render_turn_extras(i: int, c: dict) -> None:
+    """Sources (collapsed) and the thumbs control, directly under the answer. No text, no emoji."""
     if c["cites"]:
-        with st.expander("📚 Sources"):
+        with st.expander("Sources", icon=":material/menu_book:"):
             for x in c["cites"]:
                 st.markdown(f"**[S{x['n']}] {x['title']}** - {x['loc']}")
                 st.caption(x["snippet"])
-    
-    # Feedback buttons using SVG icons for a clean look
-    if c.get("ok", True) and c["rating"] is None:
-        b1, b2, _ = st.columns([1, 1, 8])
-        if b1.button("👍", key=f"fb_up_{c['uid']}", on_click=rate, args=(i, 1)):
-            pass
-        if b2.button("👎", key=f"fb_dn_{c['uid']}", on_click=rate, args=(i, -1)):
-            pass
-    elif c["rating"] == 1:
-        st.markdown("<div style='color:#10B981; font-size:0.8rem; text-align:right; padding-right:10px;'>👍</div>", unsafe_allow_html=True)
-    elif c["rating"] == -1:
-        st.markdown("<div style='color:#EF4444; font-size:0.8rem; text-align:right; padding-right:10px;'>👎</div>", unsafe_allow_html=True)
+    if c.get("ok", True):
+        key = f"fb_{c['uid']}"
+        if key not in ss_ and c.get("rating") in (1, -1):  # widget state is dropped when the page is left; restore it
+            ss_[key] = 1 if c["rating"] == 1 else 0
+        st.feedback("thumbs", key=key, on_change=_fb_changed, args=(c["uid"],))
+
+
+def render_turn(i: int, c: dict) -> None:
+    with st.chat_message("user", avatar=AV_USER):
+        st.write(c["q"])
+    with st.chat_message("assistant", avatar=AV_BOT):
+        st.write(c["a"])
+        render_turn_extras(i, c)
 
 
